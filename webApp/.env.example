# Publica. URL de la API local; la imprime `npx supabase start` (o `npx supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publica. Anon key demo del stack local, igual en toda instalacion; sale de `npx supabase status`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# SECRETO, sale de `npx supabase status`. Salta RLS. NUNCA con prefijo NEXT_PUBLIC_: el prefijo la manda al navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Conexion directa local de `npx supabase status`; solo la usan el seed y los scripts de verificacion, webApp/src no la lee.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# No secreta. Origen publico de la app para mails, sitemap y Open Graph (lib/server/site-url.ts).
SITE_URL=http://localhost:3000
# No secreta. Host de Mailpit, que levanta `npx supabase start`; en produccion lo reemplaza el transporte real.
SMTP_HOST=127.0.0.1
# No secreta. Puerto SMTP de Mailpit local.
SMTP_PORT=54325
# No secreta. Transporte de mail: smtp (Mailpit local, default) o resend (produccion). ADR-014.
MAIL_TRANSPORT=smtp
# SECRETO. API key de Resend, solo servidor, obligatoria con MAIL_TRANSPORT=resend. NUNCA con prefijo NEXT_PUBLIC_.
RESEND_API_KEY=
# No secreta. Remitente de los mails transaccionales; con resend: dominio verificado (SPF + DKIM).
MAIL_FROM_ADDRESS=hola@humano-despierto.local
# No secreta. Nombre visible del remitente; solo ASCII con resend.
MAIL_FROM_NAME=Humano Despierto
# SECRETO. YouTube Data API v3 (Google Cloud), solo servidor. Sin ella no se puede publicar una leccion.
YOUTUBE_API_KEY=
# SECRETO. OAuth de Google (T-041). No los lee Next sino el CLI de Supabase al hacer `npx supabase start`,
# vía env() en supabase/config.toml; cambiarlos exige `npx supabase stop && npx supabase start`.
# Requieren un proyecto de Google Cloud del PO con un cliente OAuth "Aplicación web" y el redirect URI
# autorizado http://127.0.0.1:54321/auth/v1/callback. Vacíos, el stack arranca y el botón de Google
# termina en un error de Google. El client ID viaja en la URL a Google, pero es de la cuenta del PO:
# no se commitea. ARCHIVO: webApp/.env.local (medido con el CLI 2.121.0 corriendo desde webApp/).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# No secreta, server-only (T-052). "true" pasa la CSP de Report-Only a enforce: solo cambia el
# nombre de la cabecera. Antes, cumplir el criterio de T-052 (engram/05_handoff_log.md): suite
# Playwright en dev y con E2E_PROD=1 en verde con cspGuard, check-seo.sh contra next start en
# SEO OK y sesion manual del player sin violaciones. Vacio o cualquier otro valor: Report-Only.
CSP_ENFORCE=

# No secreta. Backend del rate limiting (T-050). Vacío o `postgres` (por defecto): tabla
# rate_limit_buckets vía service_role. `memory` SOLO para Vitest: se resetea al reiniciar y no se
# comparte entre instancias. Registro, login, recuperación y OAuth no pasan por acá: los limita
# GoTrue por IP (supabase/config.toml [auth.rate_limit]; local: email_sent = 30/h,
# sign_in_sign_ups = 30/5 min, token_verifications = 30/5 min; en la nube, el dashboard).
RATE_LIMIT_BACKEND=
